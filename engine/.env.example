# Copy to engine/.env and fill in real values. Never commit engine/.env.
DB=image_db
DB_USER=postgres
PASSWORD=change-me
DB_HOST=localhost
PORT=5432

# Directory of images served under /images (defaults to engine/test_data/a)
IMAGES_PATH=./test_data/a

# Directory holding locally downloaded model weights (defaults to engine/models)
# MODELS_PATH=

# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# When set, /search requires the X-API-Key header to match this value
API_KEY=

# Uvicorn bind address when running `python server.py`
HOST=127.0.0.1
SERVER_PORT=8000
