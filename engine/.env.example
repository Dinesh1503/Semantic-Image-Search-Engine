# Copy to engine/.env and fill in real values. Never commit engine/.env.
DB=image_db
DB_USER=postgres
PASSWORD=change-me
DB_HOST=localhost
PORT=5432

# Absolute path to the directory of images served under /images.
# The engine/test_data/a default is not shipped with the repo, so set this.
IMAGES_PATH=/absolute/path/to/images

# Directory holding locally downloaded model weights (defaults to engine/models)
# MODELS_PATH=

# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# When set, /search requires the X-API-Key header to match this value
API_KEY=

# Uvicorn bind address when running `python server.py`
HOST=127.0.0.1
SERVER_PORT=8000
